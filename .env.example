# Copy to .env using: python3 scripts/init_env.py
# Real secrets stay in .env, never in source control or chat.
# 本地 PostgreSQL 密码；脚本会同时替换连接串中的占位符。
POSTGRES_PASSWORD=replace-with-random-app-password
ADMIN_API_KEY=replace-with-random-admin-key
# Compose 覆盖为容器地址 postgres:5432；本机使用 5433。
DATABASE_URL=postgresql+psycopg://rag:replace-with-random-app-password@127.0.0.1:5433/rag
# 检索集合绑定模型；更换模型需显式重建，不得混用不同模型的向量。
RETRIEVAL_COLLECTION=team-rag-bge-zh-v1
# Embeddings 协议根地址，客户端在其后追加 /embeddings。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 当前选用的中文向量模型；不是聊天生成模型。
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 仅在私有 .env 中填写真实值，不要填写或提交到本示例文件。
EMBEDDING_API_KEY=
# 必须与模型实际输出和 pgvector 列一致。
EMBEDDING_DIMENSIONS=1024
# 仅查询端使用的 BGE 检索指令，正文向量化不自动追加此值。
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 本机 API 端口，容器内固定为 8000。
API_PORT=8000

# 宿主机原文件目录；Compose 覆盖为共享卷路径。
UPLOAD_DIR=data/uploads
