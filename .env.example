# Copy to .env using: python3 scripts/init_env.py
# Real secrets stay in .env, never in source control or chat.
# 数据库初始化管理员密码，仅用于 MySQL 镜像初始化，不用于业务连接。
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
# 业务账号 rag 的密码；init_env.py 同时替换 DATABASE_URL 中的相同占位符。
MYSQL_PASSWORD=replace-with-random-app-password
# 知识库管理接口的管理员凭据，与云模型的 Key 完全不同。
ADMIN_API_KEY=replace-with-random-admin-key
# 宿主机开发连接地址；Compose 会改为容器网络中的 mysql:3306。
DATABASE_URL=mysql+pymysql://rag:replace-with-random-app-password@127.0.0.1:3307/rag?charset=utf8mb4
# 宿主机 ES 地址；Compose 会覆盖为 http://elasticsearch:9200。
ES_URL=http://127.0.0.1:9200
# 索引名称绑定模型和维度，更换 Embedding 模型时应换索引并重建数据。
ES_INDEX=team-rag-bge-zh-v1
# Embeddings 协议根地址，客户端在其后追加 /embeddings。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 当前选用的中文向量模型；不是聊天生成模型。
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 仅在私有 .env 中填写真实值，不要填写或提交到本示例文件。
EMBEDDING_API_KEY=
# 必须与模型实际输出和 ES dense_vector 映射一致。
EMBEDDING_DIMENSIONS=1024
# 仅查询端使用的 BGE 检索指令，正文向量化不自动追加此值。
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 本机 API 端口，容器内固定为 8000。
API_PORT=8000
